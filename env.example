# ══════════════════════════════════════════
# AlgoTrader Pro — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ══════════════════════════════════════════

# ── Broker ─────────────────────────────────
# Options: MT5 | Binance | Bybit
BROKER=MT5

# ── MetaTrader 5 ────────────────────────────
MT5_SERVER=ICMarkets-Live
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_mt5_password

# ── Crypto Exchange (Binance/Bybit) ─────────
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# ── Trading Parameters ──────────────────────
SYMBOL=XAUUSD
TIMEFRAME=5
LOT_SIZE=0.01
MAX_SL_PIPS=50
RR_RATIO=4.0
MAX_DRAWDOWN_PCT=10.0

# ── Session Filters ─────────────────────────
LONDON_SESSION=true
NY_SESSION=true

# ── Telegram Alerts ─────────────────────────
# Get token from @BotFather, chat_id from @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard ───────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8765
DASHBOARD_PORT=8080
